#compdef excise

autoload -U is-at-least

_excise() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--config=[Read configuration from FILE]:FILE:_files' \
'--scan-threads=[Scanner worker count (1-32)]:COUNT:_default' \
'--event-buffer=[Bounded worker-event capacity (16-4096)]:COUNT:_default' \
'*--exclude=[Ordered gitignore-style exclusion pattern]:PATTERN:_default' \
'--memory-mib=[Whole-process memory envelope in MiB]:MIB:_default' \
'--temporary-storage-mib=[Combined scanner-task, directory-plan/result, and identity-spill temporary storage limit per session (2+)]:MIB:_default' \
'--theme=[Built-in semantic color theme]:THEME:(excise-dark excise-light high-contrast monochrome dracula tokyo-night catppuccin-mocha catppuccin-latte gruvbox-dark gruvbox-light nord solarized-dark solarized-light one-dark monokai)' \
'--keymap=[Keyboard preset. Arrows and safety keys always work]:PRESET:(vim custom emacs)' \
'--format=[Output mode. Table and JSON never acquire a terminal]:FORMAT:(tui table json)' \
'--output=[Write a noninteractive report to FILE instead of stdout]:FILE:_files' \
'-a[Show apparent file sizes instead of allocated bytes]' \
'--apparent-size[Show apparent file sizes instead of allocated bytes]' \
'--cross-filesystems[Permit traversal across filesystem boundaries]' \
'--reduced-motion[Disable nonessential motion]' \
'--ascii[Use ASCII-only symbols and borders]' \
'--mouse[Enable mouse capture and selection]' \
'-d[Do not ask for confirmation before deleting]' \
'--disable-delete-confirmation[Do not ask for confirmation before deleting]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
'::folder -- Folder to scan:_files' \
&& ret=0
}

(( $+functions[_excise_commands] )) ||
_excise_commands() {
    local commands; commands=()
    _describe -t commands 'excise commands' commands "$@"
}

if [ "$funcstack[1]" = "_excise" ]; then
    _excise "$@"
else
    compdef _excise excise
fi
